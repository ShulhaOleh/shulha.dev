{
    "name": "shulha.dev",
    "private": true,
    "license": "MIT",
    "type": "module",
    "packageManager": "bun@1.4.2",
    "scripts": {
        "dev": "bun scripts/dev.ts",
        "build": "bun scripts/build.ts",
        "deploy:rebuild": "wrangler deploy --config workers/rebuild/wrangler.jsonc",
        "fetch": "bun scripts/fetch-github.ts",
        "typecheck": "bun node_modules/typescript7/bin/tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "checks": "bun run format:check && bun run lint && bun run typecheck",
        "prepare": "husky"
    },
    "dependencies": {
        "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@kitajs/html": "^4.2.13",
        "lucide-static": "^1.49.0",
        "simple-icons": "^16.33.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@commitlint/types": "^21.2.3",
        "@eslint/js": "^10.0.1",
        "@resvg/resvg-js": "^2.6.2",
        "@tabler/icons": "^3.48.0",
        "@types/bun": "^1.4.2",
        "bun-plugin-tailwind": "^0.1.2",
        "devicon": "^2.17.0",
        "eslint": "^10.11.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "satori": "^0.33.5",
        "tailwindcss": "^4.3.3",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.71.0",
        "typescript7": "npm:typescript@7.0.2",
        "wrangler": "^4.146.0"
    }
}
