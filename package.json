{
    "name": "shulha.dev",
    "private": true,
    "license": "MIT",
    "type": "module",
    "packageManager": "bun@1.4.4",
    "scripts": {
        "dev": "bun scripts/dev.ts",
        "build": "bun scripts/build.ts",
        "deploy:rebuild": "wrangler deploy --config workers/rebuild/wrangler.jsonc",
        "fetch": "bun scripts/fetch-github.ts",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "bun fmt",
        "format:check": "bun fmt --check",
        "checks": "bun run format:check && bun run lint && bun run typecheck",
        "prepare": "husky"
    },
    "dependencies": {
        "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@kitajs/html": "^4.2.13",
        "lucide-static": "^1.56.0",
        "simple-icons": "^16.35.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@commitlint/types": "^21.2.3",
        "@resvg/resvg-js": "^2.6.2",
        "@tabler/icons": "^3.49.0",
        "@types/bun": "^1.4.4",
        "bun-plugin-tailwind": "^0.1.2",
        "devicon": "^2.17.0",
        "husky": "^9.1.7",
        "oxlint": "^1.88.0",
        "oxlint-tsgolint": "^7.0.2004",
        "satori": "^0.55.5",
        "sharp": "^0.35.5",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "wrangler": "^4.150.0"
    }
}
